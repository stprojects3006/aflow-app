        "type": "timeseries",
        "targets": [
          {
            "expr": "(rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"400\"}[5m]) / rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\"}[5m])) * 100",
            "legendFormat": "400 Bad Request %"
          },
          {
            "expr": "(rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"401\"}[5m]) / rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\"}[5m])) * 100",
            "legendFormat": "401 Unauthorized %"
          },
          {
            "expr": "(rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"403\"}[5m]) / rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\"}[5m])) * 100",
            "legendFormat": "403 Forbidden %"
          },
          {
            "expr": "(rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"404\"}[5m]) / rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\"}[5m])) * 100",
            "legendFormat": "404 Not Found %"
          },
          {
            "expr": "(rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"500\"} and uri!=\"/integration/queueit/health\"[5m]) / rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\"}[5m])) * 100",
            "legendFormat": "500 Internal Server Error % (excl. health)"
