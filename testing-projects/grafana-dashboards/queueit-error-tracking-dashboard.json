{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "QueueIt Error Tracking Dashboard",
    "tags": ["queueit", "errors", "http-codes", "petclinic"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Error Rate by HTTP Status Code",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/integration/queueit/health\",status=\"400\"}[5m])",
            "legendFormat": "/health - 400 Bad Request"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/integration/queueit/health\",status=\"401\"}[5m])",
            "legendFormat": "/health - 401 Unauthorized"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/integration/queueit/health\",status=\"403\"}[5m])",
            "legendFormat": "/health - 403 Forbidden"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/integration/queueit/health\",status=\"404\"}[5m])",
            "legendFormat": "/health - 404 Not Found"
          },

          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/integration/queueit/health\",status=\"502\"}[5m])",
            "legendFormat": "/health - 502 Bad Gateway"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/integration/queueit/health\",status=\"503\"}[5m])",
            "legendFormat": "/health - 503 Service Unavailable"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 0.1
                }
              ]
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Total Errors by Status Code",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"400\"})",
            "legendFormat": "400 Bad Request"
          },
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"401\"})",
            "legendFormat": "401 Unauthorized"
          },
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"403\"})",
            "legendFormat": "403 Forbidden"
          },
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"404\"})",
            "legendFormat": "404 Not Found"
          },
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"500\"} and uri!=\"/integration/queueit/health\")",
            "legendFormat": "500 Internal Server Error (excl. health)"
          },
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"502\"})",
            "legendFormat": "502 Bad Gateway"
          },
          {
            "expr": "sum(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",status=\"503\"})",
            "legendFormat": "503 Service Unavailable"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
