{
  "dashboard": {
    "id": null,
    "title": "QueueIt Request Volume Dashboard",
    "tags": ["queueit", "volume", "traffic"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total QueueIt Requests",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(queueit_filter_requests_total)",
            "legendFormat": "Total Requests Processed",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "list",
              "orientation": "auto"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 2,
        "title": "QueueIt Redirect Rate",
        "type": "stat",
