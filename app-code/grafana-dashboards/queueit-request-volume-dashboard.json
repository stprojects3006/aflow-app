      {
        "id": 8,
        "title": "QueueIt Requests by IP Address",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (client_ip) (rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",client_ip=~\"192\\.168\\..*\"}[5m]))",
            "legendFormat": "North America (192.168.x.x)"
          },
          {
            "expr": "sum by (client_ip) (rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",client_ip=~\"10\\..*\"}[5m]))",
            "legendFormat": "Private Network (10.x.x.x)"
          },
          {
            "expr": "sum by (client_ip) (rate(http_server_requests_seconds_count{uri=~\"/integration/queueit/.*\",client_ip=~\"172\\.16\\..*\"}[5m]))",
