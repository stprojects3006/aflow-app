{
  "dashboard": {
    "id": null,
    "title": "PetClinic HTTP & Queue Traffic",
    "tags": ["petclinic", "http", "queueit", "traffic"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Total HTTP Requests (All Endpoints)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "sum(http_server_requests_seconds_count)",
            "legendFormat": "Total HTTP Requests",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "type": "stat",
        "title": "Total Requests to /integration/queueit/queue",
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "sum(http_server_requests_seconds_count{uri=\"/integration/queueit/queue\"})",
            "legendFormat": "Total /queue Requests"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "id": 2,
        "title": "Requests by Status Code",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 6, "w": 16, "h": 8},
        "targets": [
          {
            "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
            "legendFormat": "Status {{status}}",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "id": 3,
        "title": "Requests by Method and Status",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 14, "w": 16, "h": 8},
        "targets": [
          {
            "expr": "sum by (method, status) (rate(http_server_requests_seconds_count[5m]))",
            "legendFormat": "{{method}} {{status}}",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "id": 4,
        "title": "Requests by URI, Method, and Status",
        "type": "table",
        "gridPos": {"x": 0, "y": 22, "w": 16, "h": 8},
        "targets": [
          {
            "expr": "sum by (uri, method, status) (http_server_requests_seconds_count)",
            "legendFormat": "{{uri}} {{method}} {{status}}",
            "refId": "A"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      },
      {
        "type": "graph",
        "title": "Active Virtual Users (VUs) Over Time",
        "gridPos": {"x": 0, "y": 30, "w": 16, "h": 8},
        "targets": [
          {
            "expr": "max_over_time(k6_vus[1m])",
            "legendFormat": "Active VUs"
          }
        ],
        "datasource": { "type": "prometheus", "uid": "prometheus" }
      }
    ]
  },
  "overwrite": true
} 